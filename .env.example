APP_ENV=development

# PostgreSQL para el runtime Node: usa el rol chatly_app, sin BYPASSRLS.
APP_DATABASE_URL=postgresql://chatly_app.PROJECT_REF:DB_PASSWORD@DB_HOST:DB_PORT/postgres?sslmode=require

# Compatibilidad temporal con las migraciones/tests Python históricos.
# DATABASE_URL: rol administrativo (postgres), solo para migraciones/DDL.
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/postgres?sslmode=require

# TEST_DATABASE_URL: compatibilidad temporal con pruebas RLS Python históricas.
# En el Session Pooler el usuario debe ser rol.project_ref y la contraseña ir URL-encoded.
TEST_DATABASE_URL=postgresql+psycopg://chatly_app.PROJECT_REF:DB_PASSWORD@DB_HOST:DB_PORT/postgres?sslmode=require

# Supabase Auth / Realtime / Storage
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# JWT verification
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Pool PostgreSQL Node (timeout y reciclado en milisegundos).
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=30000
DB_POOL_RECYCLE=1800000

# URLs usadas por enlaces de autenticación.
FRONTEND_URL=http://localhost:3000