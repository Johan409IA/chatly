APP_ENV=development

# Servidor del backend en Windows (desarrollo).
# Granian usa `loop=auto`; con `winloop` instalado (grupo dev, solo win32) usa
# un loop compatible con psycopg async. No requiere variables de entorno.
# En Linux el loop por defecto ya funciona y `winloop` no se instala.

# Supabase PostgreSQL
# DATABASE_URL: rol administrativo (postgres) solo para migraciones/DDL.
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/postgres?sslmode=require

# APP_DATABASE_URL: rol de aplicación (chatly_app, sin BYPASSRLS) para el runtime.
# Si no se define, el runtime cae a TEST_DATABASE_URL.
APP_DATABASE_URL=postgresql+psycopg://chatly_app.PROJECT_REF:DB_PASSWORD@DB_HOST:DB_PORT/postgres?sslmode=require

# TEST_DATABASE_URL: rol de aplicación para las pruebas RLS.
# En el Session Pooler el usuario debe ser rol.project_ref y la contraseña ir URL-encoded.
TEST_DATABASE_URL=postgresql+psycopg://chatly_app.PROJECT_REF:DB_PASSWORD@DB_HOST:DB_PORT/postgres?sslmode=require

# Supabase Auth / Realtime / Storage
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# JWT verification
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Storage
SUPABASE_AVATARS_BUCKET=avatars

# Pool de conexiones (valores por defecto: 5, 10, 30 y 1800)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Nivel de logging (por defecto INFO)
LOG_LEVEL=INFO

# Frontend y CORS (desarrollo): el navegador llama al API en otro puerto.
# En producción, si el API y la UI comparten origen, API_PUBLIC_URL puede
# quedar vacío para usar rutas relativas.
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000